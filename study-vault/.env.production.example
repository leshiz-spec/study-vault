# Copy this file to .env.production on the deployment server.
# Use strong, unique values; do not commit the real file.
POSTGRES_DB=studyvault
POSTGRES_USER=studyvault_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=jdbc:postgresql://postgres:5432/studyvault
DATABASE_USERNAME=studyvault_app
DATABASE_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_SECONDS=86400
AUTH_COOKIE_SECURE=true
