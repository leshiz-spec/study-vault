POSTGRES_DB=studyvault
POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
POSTGRES_USER=studyvault
POSTGRES_PASSWORD=change-me
# Local backend datasource (override with PostgreSQL in production)
DATABASE_URL=jdbc:postgresql://localhost:5432/studyvault
DATABASE_USERNAME=studyvault
DATABASE_PASSWORD=change-me
SERVER_PORT=8080
# Replace before deploying. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=86400
AUTH_COOKIE_SECURE=false
# Optional: leave empty to disable AI features
AI_API_KEY=
