# Copy this file to .env for local Docker Compose use. Replace both secret
# placeholders before starting the application; never commit the resulting .env.
POSTGRES_DB=studyvault
POSTGRES_USER=studyvault
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Use a long, random value (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRATION_SECONDS=86400

# Keep false for plain HTTP local development. Set true when production uses HTTPS.
AUTH_COOKIE_SECURE=false
APP_PORT=80

# Optional AI note summaries. Leave AI_API_KEY blank to use the local fallback.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=20
# AI_LOCAL_FALLBACK=true

# Optional image overrides for registries or pinned versions:
# POSTGRES_IMAGE=postgres:16-alpine
# MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
# JAVA_IMAGE=eclipse-temurin:17-jre
# NODE_IMAGE=node:20-alpine
# NGINX_IMAGE=nginx:1.27-alpine
